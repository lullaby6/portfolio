---
// The blur is applied to each blob directly instead of a full-screen
// backdrop-blur layer: a backdrop filter over animated content has to be
// recomputed for the whole viewport every frame, which made the page lag.
---

<span class="fixed top-0 left-0 w-screen h-screen overflow-hidden">
  <span
    class="absolute top-0 left-0 h-screen w-screen bg-gradient-to-r from-blue-500 via-purple-500 to-purple-800"
  ></span>
  <span class="absolute top-0 left-0 h-screen w-screen bg-black opacity-[0.9]"
  ></span>

  <span
    class="bg-blob absolute top-0 left-0 h-64 w-64 m-6 md:m-32 rounded-full bg-gradient-to-r from-blue-500 via-purple-500 to-purple-800 opacity-25 blur-[40px] will-change-transform animate-blob motion-reduce:animate-none"
  >
  </span>

  <span
    class="bg-blob absolute bottom-0 left-0 h-64 w-64 rounded-full mx-128 my-32 bg-gradient-to-r from-blue-500 via-purple-500 to-purple-800 opacity-25 blur-[40px] will-change-transform animate-blob motion-reduce:animate-none hidden md:block"
  >
  </span>

  <span
    class="bg-blob absolute top-0 right-0 h-48 w-48 rounded-full mx-32 my-32 bg-gradient-to-r from-blue-500 via-purple-500 to-purple-800 opacity-25 blur-[40px] will-change-transform animate-blob motion-reduce:animate-none hidden md:block"
  >
  </span>

  <span
    class="bg-blob absolute bottom-0 right-0 h-64 w-64 rounded-full m-6 md:m-64 bg-gradient-to-r from-blue-500 via-purple-500 to-purple-800 opacity-25 blur-[40px] will-change-transform animate-blob motion-reduce:animate-none"
  >
  </span>
</span>
